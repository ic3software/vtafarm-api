FROM golang:1.26-alpine3.23

WORKDIR /app

# Install air for hot reload
RUN go install github.com/air-verse/air@latest

# Pre-download dependencies (layer cached unless go.mod changes)
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

# Source is mounted as a volume from host; air watches and rebuilds on change
CMD ["air", "-c", ".air.toml"]
