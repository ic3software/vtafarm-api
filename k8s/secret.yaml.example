apiVersion: v1
kind: Secret
metadata:
  name: vtafarm-api-secrets
  namespace: default
type: Opaque
stringData:
  # ── Auth ─────────────────────────────────────────────────────────────────────
  JWT_SECRET: "replace-with-strong-secret"

  # ── Cluster ──────────────────────────────────────────────────────────────────
  # External IP of the cluster's Ingress-NGINX LoadBalancer
  CLUSTER_INGRESS_IP: ""

  # ── Cloudflare ───────────────────────────────────────────────────────────────
  # API token: Zone → DNS → Edit permission on your root domain
  CLOUDFLARE_API_TOKEN: ""
  CLOUDFLARE_ZONE_ID: ""

  # ── DID Hosting ──────────────────────────────────────────────────────────────
  # vtafarm-api's own identity for the hosting control API — not anything a
  # daemon issued. Generate with: make gen-keypair, then add DID_HOSTING_DID to
  # the daemon's ACL with role=admin. One keypair serves every daemon it is
  # enrolled in; a rebuilt platform stack needs it enrolled again.
  #
  # MEDIATOR_DID, DID_HOSTING_CONTROL_URL and DID_HOSTING_SERVER_URL used to sit
  # here and be pasted in from the platform stack page. They are now read off
  # the platform stack's own session row at create time.
  DID_HOSTING_DID: ""
  DID_HOSTING_PRIVATE_KEY: ""

  # ── Monitoring ───────────────────────────────────────────────────────────────
  # Shared secret gating the /api/v1/monitor/* endpoints polled by UptimeRobot
  # (passed as ?token=). Generate with: openssl rand -hex 32
  # Empty = endpoints disabled (404).
  MONITOR_TOKEN: ""
