apiVersion: v1
kind: Secret
metadata:
  name: cipherportal-api-secrets
  namespace: default
type: Opaque
stringData:
  # ── Auth ─────────────────────────────────────────────────────────────────────
  JWT_SECRET: "replace-with-strong-secret"

  # ── Cloudflare ───────────────────────────────────────────────────────────────
  # API token: Zone → DNS → Edit permission on your root domain
  CLOUDFLARE_API_TOKEN: ""
  CLOUDFLARE_ZONE_ID: ""

  # ── DID Hosting ──────────────────────────────────────────────────────────────
  # Generate with: make gen-keypair
  # Then add DID_HOSTING_DID to the hosting service ACL (role=Service, label=cipherportal)
  DID_HOSTING_CONTROL_URL: ""
  DID_HOSTING_SERVER_URL: ""
  DID_HOSTING_DID: ""
  DID_HOSTING_PRIVATE_KEY: ""
