# App
APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-me-in-production

# Database
# Local dev: DB_HOST=localhost
# Docker Compose: DB_HOST is overridden to "db" in docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cipherportal
DB_SSLMODE=disable

# Kubernetes
# Leave empty to use ~/.kube/config (auto-detected)
KUBECONFIG=
# Namespace prefix for user isolation: cp-user-{userID}
K8S_NAMESPACE_PREFIX=cp-user
# Container image used by the vta-setup K8s Job (required for setup execution)
VTA_IMAGE=

# Cluster (required for setup wizard)
# External IP of the cluster's Ingress-NGINX LoadBalancer
CLUSTER_INGRESS_IP=

# Cloudflare (required for setup wizard)
# API token needs Zone:DNS:Edit permission
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# GHCR image listing (powers the image version dropdown)
# GitHub PAT with read:packages scope (optional — public packages work without it)
GITHUB_TOKEN=
# Package coordinates: ghcr.io/{GITHUB_PACKAGE_OWNER}/{GITHUB_PACKAGE_NAME}
GITHUB_PACKAGE_OWNER=ic3software
GITHUB_PACKAGE_NAME=vta
