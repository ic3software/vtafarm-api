# App
APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-me-in-production

# Database
# Local dev: DB_HOST=localhost
# Docker Compose: DB_HOST is overridden to "db" in docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vtafarm
DB_SSLMODE=disable

# Kubernetes
# Leave empty to use ~/.kube/config (auto-detected)
KUBECONFIG=
# Namespace prefix for user isolation: vtafarm-user-{userID}
K8S_NAMESPACE_PREFIX=fpp-user

# Cluster (required for setup wizard)
# External IP of the cluster's Ingress-NGINX LoadBalancer
CLUSTER_INGRESS_IP=
# Root domain managed by Cloudflare (subdomains will be created under this)
CLUSTER_DOMAIN=

# Cloudflare (required for setup wizard)
# API token needs Zone:DNS:Edit permission
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Package coordinates: ghcr.io/{GITHUB_PACKAGE_OWNER}/{GITHUB_PACKAGE_NAME}
GITHUB_PACKAGE_OWNER=ic3software
GITHUB_PACKAGE_NAME=vta
GITHUB_MEDIATOR_PACKAGE_NAME=mediator
GITHUB_DID_HOSTING_DAEMON_PACKAGE_NAME=did-hosting-daemon
GITHUB_VTC_PACKAGE_NAME=vtc

# Passkey / WebAuthn
# Dev: RPID=localhost, ORIGINS=http://localhost:5173
# Prod: RPID=vtafarm.firstperson.dev, ORIGINS=https://vtafarm.firstperson.dev
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:5173
WEBAUTHN_RP_DISPLAY_NAME="VTA Farm"

# DID Hosting (optional — enables automatic did.jsonl upload after VTA setup)
#
# vtafarm-api's own keypair: `make gen-keypair`, then enroll DID_HOSTING_DID in
# the daemon's ACL with role=admin. A rebuilt platform stack is a fresh daemon
# with an empty ACL — enroll the same keypair again.
#
# No URLs here: which daemon a session talks to is stored on the session
# (setup_sessions.did_hosting_*_url). See docs/vta-setup-design.md.
DID_HOSTING_DID=
DID_HOSTING_PRIVATE_KEY=

# HashiCorp Vault — stores each VTA's master seed. ROLE_ID/SECRET_ID come from
# the vtafarm-api-vault Secret (helm/vtafarm-vault/bootstrap.sh).
# VAULT_ADDR: how this API reaches Vault (local dev: port-forward 127.0.0.1).
# VAULT_VTA_ADDR: in-cluster svc DNS baked into VTA pod configs.
VAULT_ADDR=https://vault.vault.svc:8200
VAULT_VTA_ADDR=https://vault.vault.svc:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KV_MOUNT=secret
VAULT_K8S_AUTH_MOUNT=kubernetes
VAULT_APPROLE_MOUNT=approle
# Self-signed in-cluster CA → skip TLS verify (true). Set false with a trusted CA.
VAULT_SKIP_VERIFY=true

# Monitoring — /api/v1/monitor/* endpoints polled by UptimeRobot.
# Generate with: openssl rand -hex 32
MONITOR_TOKEN=
# Alarm thresholds (%): per-node CPU/memory usage, Longhorn disk usage
MONITOR_CPU_PCT=90
MONITOR_MEM_PCT=90
MONITOR_STORAGE_PCT=85
# A container restart within this window alarms (time-based so it self-clears)
MONITOR_RESTART_WINDOW_MIN=15
# How long a pod may sit Pending / not-Ready before alarming
MONITOR_PENDING_GRACE_MIN=10
# Infra namespaces watched in addition to {K8S_NAMESPACE_PREFIX}-*.
# vault-transit can't be health-checked directly (NetworkPolicy allows only the
# vault namespace to reach it) — but its pod status covers it: a sealed transit
# Vault fails its readiness probe, so it alarms as not-Ready here.
MONITOR_EXTRA_NAMESPACES=vault,vault-transit,longhorn-system
